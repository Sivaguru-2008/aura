# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
# pytest scratch dir: it is currently unreadable (WinError 5) and, if committed,
# breaks test collection with a PermissionError before a single test runs.
aura/pytest-tmp/

# runtime state (regenerated on first run) — keep trained .npz models so
# judges can serve without training
aura/artifacts/aura.db
# Append-only audit log: every prediction adds a line, so tracking it made the
# tree dirty on any demo or test run. Created on demand by audit_log.py (append
# mode) and read behind an exists() guard, so a fresh clone is fine without it.
aura/artifacts/inference_log.jsonl

# editor/os noise
.vscode/
.idea/
Thumbs.db
.DS_Store

# large datasets, zip archives, and manifests
archive.zip
mimic_cxr_data/
manifest.jsonl

# deep learning checkpoints / tensorboard logs
aura/artifacts/*.pt
aura/artifacts/tb/


# Brain Vision Engine (NeuroMind) — derived artefacts, all regenerable:
#   cache/        11 GB of standardised voxels; rebuild with `cli ingest`
#   checkpoints/  ~300 MB of weights; rebuild with `cli train`
#   embeddings/   one 3.5 MB store per epoch
# The reports, the model card, and the latest embedding store stay: they are the
# evidence, and `latest.npz` is the representation downstream modules are told not to
# recompute.
aura/artifacts/brain/cache/
aura/artifacts/brain/checkpoints/
aura/artifacts/brain/tensorboard/
aura/artifacts/brain/embeddings/epoch_*.npz

# IBM Quantum token — never commit (holds a real secret once filled)
ibm_quantum.env

# Local deployment overrides. .env.example is the committed template.
.env
.env.local
.env.*.local

# Datasets and large local data — never push (kept local, see E:\AURA root)
datasets/
demo_data/
/structure.txt
