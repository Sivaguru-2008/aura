# Shell scripts must keep LF endings. This repo is authored on Windows, and a
# CRLF-terminated shebang makes Linux report "no such file or directory" for the
# interpreter — which is how a container entrypoint fails with a message that
# names neither the script nor the shell.
*.sh text eol=lf
deploy/entrypoint.sh text eol=lf

# Dockerfiles and CI definitions are read by Linux tooling.
Dockerfile text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows launchers stay CRLF.
*.bat text eol=crlf

# Binary artifacts: never touch, never diff.
*.pt binary
*.npz binary
*.npy binary
*.joblib binary
*.png binary
*.jpg binary
*.db binary
*.nii binary
*.nii.gz binary
*.dcm binary
