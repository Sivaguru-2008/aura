# AURA — docker compose overrides. Copy to .env and edit; every value here is
# already the built-in default, so an empty .env changes nothing.
#
#   cp .env.example .env
#
# .env itself is gitignored (see .dockerignore / .gitignore) — never commit it.
# Installing at a hospital? Read docs/HOSPITAL_IT_INSTALL.md first.

# --- ports ------------------------------------------------------------------ #
AURA_PORT=8000
AURA_DICOM_PORT=11112

# --- preflight -------------------------------------------------------------- #
# strict  a failed check stops the container (default)
# warn    report problems, start anyway
# skip    do not check
AURA_PREFLIGHT=strict

# --- brain MRI -------------------------------------------------------------- #
# 1 = build/run without the 90 MB BraTS checkpoint; brain studies unavailable
# and the missing weight is a warning rather than an error.
AURA_SKIP_BRAIN=0

# Base URL serving the model_export/ file names (e.g. a GitHub Release), used at
# build time to fetch the brain weights. Leave empty to build from the working
# tree or to build chest-only.
AURA_MODELS_URL=

# --- resources -------------------------------------------------------------- #
# Below ~4g the first brain study OOM-kills the container.
AURA_MEM_LIMIT=6g
AURA_THREADS=4

# --- logging ---------------------------------------------------------------- #
AURA_LOG_LEVEL=info

# --- access control --------------------------------------------------------- #
# Empty = the API answers only requests that start inside the container itself.
# A browser reaches the container through Docker's network rather than loopback, so
# with no token it gets a 403 that says to set one. That is deliberate: GET /v1/cases
# enumerates case ids, /v1/cases/{id} returns the full bundle, and the FHIR/HL7
# exports emit clinical records built for another system to ingest.
#
# Generate a token and paste it here:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Browsers sign in once with their name and this token and get a signed, HttpOnly,
# SameSite=Strict session cookie lasting AURA_SESSION_TTL_HOURS. Scripts send
# `x-aura-token: <value>` (or `Authorization: Bearer <value>`) plus `x-aura-user: <who>`,
# which is what makes each call attributable in the audit log. Changing the token
# signs everyone out. /v1/health stays open so container probes keep working.
AURA_AUTH_TOKEN=
AURA_AUTH_HEADER=x-aura-token
AURA_SESSION_TTL_HOURS=12

# 1 = with no token, serve the network anyway (the pre-2026-09-12 behaviour).
# Isolated demo networks only; preflight warns on every boot while it is set.
AURA_ALLOW_OPEN_ACCESS=0

# Per-principal requests/minute. 0 = unlimited. The bucket is in-process, so with N
# replicas behind a load balancer the effective ceiling is N x this value.
AURA_RATE_LIMIT_RPM=0

# --- site identity ---------------------------------------------------------- #
# One AURA server and one database per hospital/site. The first start stamps this id
# into the database; a server with a different id then refuses to open it, so a
# misconfigured server can never serve one site's cases under another's name.
AURA_SITE_ID=

# --- case store ------------------------------------------------------------- #
# Empty = SQLite on the aura-state volume (fine for one site on one box).
# For PostgreSQL, start with `docker compose --profile postgres up -d` and set both.
# URL-encode any special characters in the password when you put it in the URL.
#   AURA_PG_PASSWORD=<a long random password>
#   AURA_DATABASE_URL=postgresql+psycopg://aura:<the same password>@postgres:5432/aura
# Several sites on one PostgreSQL server: create one schema per site
# (CREATE SCHEMA site_a AUTHORIZATION aura;) and append to that site's URL:
#   ?options=-csearch_path%3Dsite_a
AURA_PG_PASSWORD=
AURA_DATABASE_URL=

# --- NOT set here ----------------------------------------------------------- #
# AURA_FUSION_BACKEND — left out so the container serves exactly what [tool.aura]
#   in aura/pyproject.toml selects ("classical" since 2026-09-12), same as a local
#   run. Set it in your shell only when you want to override that (e.g. "quantum"
#   to reproduce the hackathon demo), and add the pass-through in docker-compose.yml.
# AURA_ALLOW_FALLBACK_VISION — leave unset/0. At 1 a container whose DenseNet
#   weights failed to load serves fabricated findings and still reports healthy.
