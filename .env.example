# AURA — docker compose overrides. Copy to .env and edit; every value here is
# already the built-in default, so an empty .env changes nothing.
#
#   cp .env.example .env
#
# .env itself is gitignored (see .dockerignore / .gitignore) — never commit it.

# --- ports ------------------------------------------------------------------ #
AURA_PORT=8000
AURA_DICOM_PORT=11112

# --- preflight -------------------------------------------------------------- #
# strict  a failed check stops the container (default)
# warn    report problems, start anyway
# skip    do not check
AURA_PREFLIGHT=strict

# --- brain MRI -------------------------------------------------------------- #
# 1 = build/run without the 90 MB BraTS checkpoint; brain studies unavailable
# and the missing weight is a warning rather than an error.
AURA_SKIP_BRAIN=0

# Base URL serving the model_export/ file names (e.g. a GitHub Release), used at
# build time to fetch the brain weights. Leave empty to build from the working
# tree or to build chest-only.
AURA_MODELS_URL=

# --- resources -------------------------------------------------------------- #
# Below ~4g the first brain study OOM-kills the container.
AURA_MEM_LIMIT=6g
AURA_THREADS=4

# --- logging ---------------------------------------------------------------- #
AURA_LOG_LEVEL=info

# --- access control --------------------------------------------------------- #
# Empty = OFF. With no token every endpoint is reachable by anyone who can route a
# packet to AURA_PORT, INCLUDING the reads that emit patient data: GET /v1/cases
# (enumerates every case id), /v1/cases/{id} (full bundle), and /v1/cases/{id}/
# export/fhir and /export/hl7, which emit standards-conformant clinical records
# built for another system to ingest. That is the correct default for the offline
# single-box demo and the wrong one for anything a second machine can reach.
#
# Set this the moment AURA is not alone on localhost:
#   AURA_AUTH_TOKEN=$(python -c "import secrets;print(secrets.token_urlsafe(32))")
# Clients then send it as `x-aura-token: <value>` (or `Authorization: Bearer <v>`)
# plus `x-aura-user: <who>`, which is what makes each call attributable in the
# audit log. /v1/health stays open so container probes keep working.
AURA_AUTH_TOKEN=
AURA_AUTH_HEADER=x-aura-token

# Per-principal requests/minute. 0 = unlimited. The bucket is in-process, so with N
# replicas behind a load balancer the effective ceiling is N x this value.
AURA_RATE_LIMIT_RPM=0

# --- NOT set here ----------------------------------------------------------- #
# AURA_FUSION_BACKEND — left out so the container serves exactly what [tool.aura]
#   in aura/pyproject.toml selects, same as a local run. Set it in your shell only
#   when you actually want to override that, and uncomment the pass-through in
#   docker-compose.yml. (A blank value is now safe — common/config.py treats a
#   present-but-empty AURA_* var as unset — but an explicit choice still belongs
#   in one place, and pyproject is that place.)
# AURA_ALLOW_FALLBACK_VISION — leave unset/0. At 1 a container whose DenseNet
#   weights failed to load serves fabricated findings and still reports healthy.
